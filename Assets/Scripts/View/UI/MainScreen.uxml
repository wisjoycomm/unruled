                    <ui:VisualElement class="board__tabs">
                        <ui:Button name="tab-system" class="board__tab board__tab--active" text="SYSTEM KEPLER" />
                        <ui:Button name="tab-galaxy" class="board__tab" text="GALAXY" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="inflight-strip" class="inflight-strip">
                    <ui:Label class="u-caption" text="IN FLIGHT" />
                    <ui:VisualElement name="inflight-list" style="flex-direction: row;">
                        <theme:DashedFrame class="u-inflight">
                            <ui:Label class="u-text" text="Move · Fleet B → Kepler-6" />
                            <ui:Label class="u-num u-inflight__eta" text="43t" />
                        </theme:DashedFrame>
                        <theme:DashedFrame class="u-inflight u-inflight--running">
                            <ui:Label class="u-text" text="ScanBelt · Rim lane" />
                            <ui:Label class="u-num u-inflight__eta" text="running" />
                        </theme:DashedFrame>
                        <theme:DashedFrame class="u-inflight u-inflight--waiting">
                            <ui:Label class="u-text" text="Activate · Fleet C" />
                            <ui:Label class="u-num u-inflight__eta" text="warm-up 120t" />
                        </theme:DashedFrame>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="side" class="side">
