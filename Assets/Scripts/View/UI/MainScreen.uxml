<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:theme="Unruled.View.UI.Theme">
    <Style src="project://database/Assets/Scripts/View/UI/MainScreen.uss" />
    <ui:VisualElement name="main" class="main" picking-mode="Ignore">
        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:Label class="top-bar__brand" text="UNRULED" />
            <ui:VisualElement class="top-bar__stat">
                <ui:Label class="top-bar__label" text="SIM CLOCK" />
                <ui:Label name="clock" class="top-bar__value" text="DAY 3 · 14:22:07" />
            </ui:VisualElement>
            <ui:VisualElement class="top-bar__stat">
                <ui:Label class="top-bar__label" text="CREDITS" />
                <ui:Label name="credits" class="top-bar__value" text="48,210" />
            </ui:VisualElement>
            <ui:VisualElement class="top-bar__stat">
                <ui:Label class="top-bar__label" text="LATENCY TO SELECTION" />
                <ui:Label name="latency" class="top-bar__value top-bar__value--you" text="85t · 2 hops" />
            </ui:VisualElement>
            <ui:VisualElement class="top-bar__spacer" />
            <ui:VisualElement class="top-bar__group">
                <ui:Label class="top-bar__label" text="NOAA" />
                <ui:Label name="noaa-r" class="u-noaa u-noaa--1" text="R1" />
                <ui:Label name="noaa-s" class="u-noaa u-noaa--0" text="S0" />
                <ui:Label name="noaa-g" class="u-noaa u-noaa--3" text="G3" />
            </ui:VisualElement>
            <ui:VisualElement class="top-bar__group">
                <ui:Label name="who-tag" class="u-tag u-tag--who" text="WHO · 1 LOCK" />
                <ui:Label name="sta-tag" class="u-tag u-tag--sta" text="STA · TOLL 4%" />
                <ui:Label name="citadel-tag" class="u-tag u-tag--citadel" text="CITADEL · 100% · T3" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="main__body" picking-mode="Ignore">
            <ui:VisualElement name="dock" class="dock">
                <ui:VisualElement class="dock__head">
                    <ui:Label class="section-title" text="STOCKPILE" />
                    <ui:Label name="dock-site" class="section-meta" text="KEPLER-3 · CORE" />
