                        <ui:VisualElement class="ops__head">
                            <ui:Label class="gauge__label" text="SELECTED FLEET" />
                            <ui:Label name="cargo-status" class="section-meta" text="NO FLEET" />
                        </ui:VisualElement>
                        <ui:VisualElement class="orders">
                            <ui:Button name="do-load" class="u-btn" text="Load 100" />
                            <ui:Button name="do-unload" class="u-btn u-btn--secondary" text="Unload 100" />
                            <ui:Button name="do-route" class="u-btn u-btn--secondary" text="Convoy route here" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="site-feedback" class="section-meta ops__feedback" text="" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="compact-nav" class="seg compact-nav">
            <ui:Button name="nav-0" class="seg__item" text="STOCK" />
            <ui:Button name="nav-1" class="seg__item seg__item--on" text="BOARD" />
            <ui:Button name="nav-2" class="seg__item" text="FLEET · OPS" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
