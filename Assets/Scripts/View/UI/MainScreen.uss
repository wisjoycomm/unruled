/*
 * Main screen layout (mockup 1440x900): 56 px top telemetry, 260 px stockpile dock, the board in the middle with a
 * 52 px in-flight strip, 360 px fleet card + WTO market on the right. Colours and type come from Theme/Unruled.uss.
 * The board area has no background: the board renderer draws behind the UI. Below 1100 px wide, CompactLayout adds
 * main--compact (phone layout, end of file).
 */

.main {
    flex-grow: 1;
}

/* The fonts' line boxes are tall; dense readouts drop label padding and pin their heights to the mockup's spacing. */
.top-bar__label, .top-bar__value, .part__label, .part__value, .stat__label, .stat__value {
    padding: 0;
    margin: 0;
}

.main__body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* ---------- Top telemetry ---------- */

.top-bar {
    height: 56px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 20px;
    background-color: var(--u-panel);
    border-bottom-width: 1px;
    border-color: var(--u-rule);
}

.top-bar__brand {
    -unity-font-definition: url("Theme/Fonts/ChakraPetch-Bold.asset");
    font-size: 22px;
    letter-spacing: 1.3px;
    margin-right: 28px;
}

.top-bar__stat {
    margin-right: 28px;
}

.top-bar__label {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 11px;
    height: 14px;
    color: var(--u-ink-dim);
}

.top-bar__value {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-SemiBold.asset");
    font-size: 15px;
    height: 19px;
}

.top-bar__value--you {
    color: var(--u-you);
}

.top-bar__spacer {
    flex-grow: 1;
}

.top-bar__group {
    flex-direction: row;
    align-items: center;
    margin-left: 20px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.top-bar__group > .u-tag {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.top-bar__group > .u-noaa, .top-bar__group > .u-tag {
    margin-left: 6px;
}

.u-noaa--0 {
    border-width: 1px;
    border-color: var(--u-rule-strong);
    color: var(--u-ink-dim);
}

.top-bar__group > .u-tag {
    padding: 4px 8px;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
}

.top-bar__citadel-icon {
    width: 24px;
    height: 24px;
    margin-left: 8px;
    margin-right: -2px;
    background-image: resource("UI/system_citadel_emblem");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: var(--u-rule);
}

/* ---------- Stockpile dock ---------- */

.dock {
    width: 260px;
    flex-shrink: 0;
    background-color: var(--u-panel);
    border-right-width: 1px;
    border-color: var(--u-rule);
}

.dock__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 14px 16px 10px 16px;
    border-bottom-width: 1px;
    border-color: var(--u-rule);
}

.section-title {
    -unity-font-definition: url("Theme/Fonts/ChakraPetch-SemiBold.asset");
    font-size: 15px;
    letter-spacing: 0.9px;
}

.section-title--wto {
    color: var(--u-wto);
}

.section-meta {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 12px;
    color: var(--u-ink-dim);
}

.dock__list {
    padding: 4px 0;
}

.stock-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 16px;
}

.stock-row > .u-icon {
    margin-right: 10px;
}

.stock-row__code {
    flex-grow: 1;
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 12px;
    color: var(--u-ink-soft);
}

.stock-row__qty {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Medium.asset");
    font-size: 13px;
}

.stock-row__trend {
    width: 44px;
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--u-ink-dim);
}

/* ---------- Board and in-flight strip ---------- */

.board {
    flex-grow: 1;
    min-width: 0;
}

.board__view {
    flex-grow: 1;
}

.board-label {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 11px;
    padding: 0;
    margin: 0;
    white-space: nowrap;
}

.board-label--strong {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-SemiBold.asset");
    font-size: 12px;
}

.board__tabs {
    position: absolute;
    left: 16px;
    top: 16px;
    flex-direction: row;
}

.unity-button.board__tab {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 12px;
    min-height: 32px;
    padding: 0 12px;
    margin: 0 6px 0 0;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--u-rule);
    background-image: none;
    background-color: var(--u-void);
    color: var(--u-ink-dim);
}

.unity-button.board__tab--active {
    background-color: var(--u-raised);
    border-color: var(--u-rule-strong);
    color: var(--u-ink);
}

.inflight-strip {
    height: 52px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    background-color: var(--u-panel);
    border-top-width: 1px;
    border-color: var(--u-rule);
}

.inflight-strip > .u-caption {
    font-size: 11px;
    margin-right: 14px;
}

.inflight-strip .u-inflight {
    padding: 6px 10px;
    margin-right: 10px;
}

.inflight-strip .u-inflight > .u-text {
    font-size: 13px;
    margin-right: 10px;
}

.u-inflight--running {
    --u-dash-color: var(--u-wto);
}

.u-inflight--running > .u-inflight__eta {
    color: var(--u-wto);
}

.u-inflight--waiting {
    --u-dash-color: var(--u-rule-strong);
}

.u-inflight--waiting > .u-text, .u-inflight--waiting > .u-inflight__eta {
    color: var(--u-ink-soft);
}

/* ---------- Right column: fleet card and market ---------- */

.side {
    width: 360px;
    flex-shrink: 0;
    background-color: var(--u-panel);
    border-left-width: 1px;
    border-color: var(--u-rule);
}

.fleet-card {
    flex-shrink: 0;
    padding: 16px;
    border-bottom-width: 1px;
    border-color: var(--u-rule);
}

.fleet-card > * {
    margin-bottom: 12px;
}

.fleet-card > .orders {
    margin-bottom: -8px;
}

.fleet-card__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.fleet-card__name {
    -unity-font-definition: url("Theme/Fonts/ChakraPetch-Bold.asset");
    font-size: 20px;
    letter-spacing: 0.8px;
}

.fleet-card__parts {
    flex-direction: row;
    margin-left: -6px;
}

.part {
    flex-grow: 1;
    flex-basis: 0;
    padding: 8px;
    margin-left: 6px;
    background-color: var(--u-void);
    border-width: 1px;
    border-color: var(--u-rule);
}

.part__icon {
    height: 44px;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.part__icon--line {
    background-image: resource("UI/ship_class_line");
}

.part__icon--ew {
    background-image: resource("UI/ship_class_ew");
}

.part__icon--supply {
    background-image: resource("UI/ship_class_supply");
}

.part__icon--cargo {
    background-image: resource("UI/ship_class_cargo");
}

.part__label {
    font-size: 11px;
    height: 15px;
    color: var(--u-ink-dim);
}

.part__value {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-SemiBold.asset");
    font-size: 18px;
    height: 24px;
}

.gauge__head {
    flex-direction: row;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 6px;
}

.gauge__label {
    font-size: 12px;
    color: var(--u-ink-dim);
}

.gauge__value {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 12px;
    color: var(--u-thermal-hot);
}

.gauge__track {
    height: 10px;
    background-color: var(--u-void);
    border-width: 1px;
    border-color: var(--u-rule);
}

.gauge__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--u-thermal-hot);
}

.gauge__fill--nominal {
    background-color: var(--u-thermal-nominal);
}

.gauge__fill--locked {
    background-color: var(--u-thermal-locked);
}

.gauge__mark {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    background-color: var(--u-ink);
}

.gauge__mark--lock {
    background-color: var(--u-danger);
}

.gauge__scale {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.gauge__scale > Label {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 11px;
    color: var(--u-ink-dim);
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat {
    width: 46%;
    height: 20px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.stat__label {
    font-size: 13px;
    color: var(--u-ink-dim);
}

.stat__value {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 13px;
}

.seg {
    flex-direction: row;
    margin-top: 6px;
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--u-rule-strong);
}

.unity-button.seg__item {
    flex-grow: 1;
    flex-basis: 0;
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 13px;
    min-height: 36px;
    margin: 0;
    border-radius: 0;
    border-width: 0;
    border-left-width: 1px;
    border-color: var(--u-rule-strong);
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    color: var(--u-ink-soft);
}

.unity-button.seg__item:hover {
    background-color: var(--u-raised);
}

.unity-button.seg__item--on {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-SemiBold.asset");
    background-color: var(--u-you);
    color: var(--u-void);
}

.unity-button.seg__item--on:hover {
    background-color: var(--u-you-hover);
}

.orders {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.orders > .u-btn {
    width: 49%;
    font-size: 14px;
    margin-bottom: 8px;
}

.market {
    flex-grow: 1;
    padding: 16px;
}

/* ---------- Side tabs and operations ---------- */

.side-tabs {
    margin: 12px 16px 0 16px;
    flex-shrink: 0;
}

.ops {
    flex-grow: 1;
}

.ops > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 16px;
}

.ops__group {
    margin-bottom: 16px;
}

.ops__group > .seg {
    margin-bottom: 8px;
}

.ops__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.ops__title-row {
    flex-direction: row;
    align-items: center;
}

.ops__emblem {
    width: 26px;
    height: 26px;
    margin-right: 8px;
    background-color: var(--u-void);
    border-width: 1px;
    border-color: var(--u-rule);
    -unity-background-scale-mode: scale-to-fit;
}

.ops__emblem--ship {
    background-image: resource("UI/ship_class_line");
}

.ops__emblem--citadel {
    background-image: resource("UI/system_citadel_emblem");
}

.ops__emblem--gate {
    background-image: resource("UI/jump_gate_emblem");
}

.ops__orders {
    margin-top: 4px;
}

.ops__feedback {
    white-space: normal;
}

.item-picker {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.unity-button.item-picker__step {
    width: 40px;
    margin: 0;
}

.item-picker__name {
    flex-grow: 1;
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-SemiBold.asset");
    font-size: 14px;
    -unity-text-align: middle-center;
}

.market__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 10px;
}

.market-row {
    flex-direction: row;
    height: 20px;
    margin-bottom: 10px;
}

.market-row--head {
    height: 21px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-color: var(--u-rule);
}

.market-row > Label {
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 13px;
    flex-basis: 0;
    flex-grow: 1;
    -unity-text-align: middle-right;
    padding: 0;
}

.market-row--head > Label {
    font-size: 11px;
    color: var(--u-ink-dim);
}

.market-row > .market-row__item {
    flex-grow: 1.6;
    -unity-text-align: middle-left;
}

.market-row > .market-row__delta {
    flex-grow: 0.9;
}

/* ---------- Phone layout (main--compact) ---------- */

.compact-nav {
    display: none;
    flex-shrink: 0;
    height: 52px;
    margin: 0;
    background-color: var(--u-panel);
    border-top-width: 1px;
    border-color: var(--u-rule);
}

.compact-nav > .unity-button.seg__item {
    height: 100%;
    font-size: 14px;
}

.main--compact > .compact-nav {
    display: flex;
}

.main--compact .top-bar {
    height: auto;
    flex-wrap: wrap;
    padding: 6px 12px;
}

.main--compact .top-bar__brand, .main--compact .top-bar__spacer {
    display: none;
}

.main--compact .top-bar__stat {
    margin: 2px 16px 2px 0;
}

.main--compact .top-bar__group {
    margin: 4px 12px 2px 0;
}

.main--compact .dock, .main--compact .side {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    border-left-width: 0;
    border-right-width: 0;
}

.main--compact.main--show-dock .dock, .main--compact.main--show-side .side {
    display: flex;
}

/* ---------- Top-bar buttons, extra emblems, market trade block ---------- */

.unity-button.top-bar__btn {
    min-height: 32px;
    height: 32px;
    min-width: 32px;
    padding: 0 0 0 30px;
    margin-left: 8px;
    font-size: 12px;
    flex-shrink: 0;
    background-image: resource("UI/alert_warning");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-position-x: left 2px;
    background-size: 28px 28px;
}

.unity-button.top-bar__btn--icon {
    width: 32px;
    padding: 0;
    background-image: resource("UI/action_pause");
    background-position-x: center;
}

.ops__emblem--market {
    background-image: resource("UI/action_market");
}

.ops__emblem--planet {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("UI/node_pristine");
}

.ops__emblem--focus {
    background-image: resource("UI/action_focus");
}

.ops__emblem--mothball {
    background-image: resource("UI/action_mothball");
}

.ops__emblem--activate {
    background-image: resource("UI/action_activate");
}

.ops__emblem--scan {
    background-image: resource("UI/action_scan");
}

.ops__emblem--ecm {
    background-image: resource("UI/action_ecm");
}

.market__trade {
    margin-top: 16px;
    padding-top: 12px;
    border-top-width: 1px;
    border-color: var(--u-rule);
}

/* ---------- Toasts: THE SYSTEM's bulletins, top right over the board ---------- */

.toasts {
    position: absolute;
    top: 64px;
    right: 372px;
    width: 340px;
}

.toast {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    margin-bottom: 8px;
    background-color: var(--u-raised);
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--u-rule-strong);
}

.toast__icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.toast__text {
    flex-shrink: 1;
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.toast--noaa { border-left-color: var(--u-noaa); }
.toast--iaea { border-left-color: var(--u-iaea); }
.toast--wto { border-left-color: var(--u-wto); }
.toast--who { border-left-color: var(--u-who); }
.toast--sta { border-left-color: var(--u-sta); }
.toast--danger { border-left-color: var(--u-danger); }

.main--compact .toasts {
    right: 8px;
    left: 8px;
    width: auto;
}

/* ---------- Modal overlay: confirm dialogs, alerts log, pause menu, end screens ---------- */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.overlay__backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--u-void);
    opacity: 0.85;
    -unity-background-scale-mode: scale-and-crop;
}

.overlay--screen > .overlay__backdrop {
    opacity: 1;
}

.modal {
    width: 520px;
    max-width: 94%;
    max-height: 86%;
    padding: 20px;
    background-color: var(--u-panel);
    border-width: 1px;
    border-top-width: 3px;
    border-color: var(--u-rule-strong);
    border-top-color: var(--u-you);
}

/* Style A plate frame: corner brackets drawn over the panel, never in the layout. */
.plate-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    --u-plate-color: var(--u-rule-strong);
}

.plate-frame--modal {
    --u-plate-color: var(--u-you);
}

.modal--danger .plate-frame--modal {
    --u-plate-color: var(--u-danger);
}

.modal--danger {
    border-top-color: var(--u-danger);
}

.modal--victory {
    border-top-color: var(--u-sta);
}

.modal__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.modal__icon {
    width: 48px;
    height: 48px;
    margin-right: 14px;
    flex-shrink: 0;
    background-color: var(--u-void);
    border-width: 1px;
    border-color: var(--u-rule);
    -unity-background-scale-mode: scale-to-fit;
}

.modal__title {
    -unity-font-definition: url("Theme/Fonts/ChakraPetch-Bold.asset");
    font-size: 22px;
    letter-spacing: 1.2px;
    color: var(--u-ink);
    white-space: normal;
    flex-shrink: 1;
}

.modal__scroll {
    flex-shrink: 1;
    margin-bottom: 16px;
}

.modal__body {
    color: var(--u-ink-soft);
}

.modal__actions {
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
}

.modal__actions > .u-btn {
    margin-left: 8px;
    margin-top: 6px;
    min-width: 120px;
}

/* ---------- Command icons on fleet orders, site section badges ---------- */

.unity-button.u-btn--icon {
    padding-left: 34px;
    background-position-x: left 8px;
    background-size: 20px 20px;
    background-repeat: no-repeat;
}

.unity-button.order-vent {
    background-image: resource("UI/cmd_vent");
    border-color: var(--u-thermal-nominal);
}

.unity-button.order-raid {
    background-image: resource("UI/cmd_raid");
}

.unity-button.order-nuke {
    background-image: resource("UI/cmd_nuke");
}

.ops__emblem--rig {
    background-image: resource("UI/badge_rig");
}

.ops__emblem--refinery {
    background-image: resource("UI/badge_refinery");
}

.ops__emblem--relay {
    background-image: resource("UI/badge_relay");
}

/* Standby trace in the in-flight strip while nothing is in flight. */
.inflight-idle {
    width: 420px;
    height: 26px;
    margin-left: 8px;
    opacity: 0.6;
    background-image: resource("UI/empty_telemetry");
    -unity-background-scale-mode: stretch-to-fill;
}

.modal--victory .plate-frame--modal {
    --u-plate-color: var(--u-sta);
}

/* ---------- Board preview plate (planet / star system) ---------- */

.preview {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 280px;
    padding: 14px;
    background-color: var(--u-panel);
    border-width: 1px;
    border-color: var(--u-rule-strong);
}

.preview__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.preview__portrait {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.preview__titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.preview__meta {
    white-space: normal;
}

.preview__title {
    -unity-font-definition: url("Theme/Fonts/ChakraPetch-SemiBold.asset");
    font-size: 15px;
    letter-spacing: 0.9px;
    white-space: normal;
}

.preview__section {
    height: 62px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-and-crop;
}

.preview__layer {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.preview__layer-name {
    width: 78px;
    font-size: 11px;
}

.preview__layer-track {
    flex-grow: 1;
    height: 8px;
}

.preview__layer-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
}

.preview__layer-fill--0 {
    background-color: var(--u-ink-dim);
}

.preview__layer-fill--1 {
    background-color: var(--u-you);
}

.preview__layer-fill--2 {
    background-color: var(--u-hostile);
}

.preview__layer-value {
    width: 76px;
    -unity-text-align: middle-right;
    -unity-font-definition: url("Theme/Fonts/IBMPlexMono-Regular.asset");
    font-size: 11px;
    color: var(--u-ink-soft);
}

.preview__thumbs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.preview__thumb {
    width: 28px;
    height: 28px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-bottom-width: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.preview__line {
    font-size: 11px;
    margin-top: 2px;
}
