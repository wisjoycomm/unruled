<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Sim Lab: runs Unruled.Core headless (compiled straight from Assets/Scripts/Core) and serves a control page. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Unruled.SimLab</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS0618;CS0162;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
