# ==============================================================================
# Project Shared Configuration (Single Source of Truth for AI Agents & Tools)
# ==============================================================================
# Edit values here, then run: python .agents/sync-rules.py
# Local machine secrets/overrides (e.g. API keys, custom paths) can be placed in
# `.env` (which is gitignored and overrides values from this file).

# --- Project Identity & Paths ---
PROJECT_NAME=Unruled
PRODUCT_NAME=Unruled
PROJECT_ROOT=D:\GameProjects\unruled
UNITY_VERSION=6000.5.7f1

# --- Documentation Paths ---
DOCS_DIR=.docs
TEMP_DIR=.temp
MASTER_GDD_DOC=.docs/unruled_master_gdd.md
MASTER_DATA_DOC=.docs/unruled_master_data_sheets.md
OVERVIEW_DOC=.docs/overview.md
ROADMAP_DOC=.docs/plan/roadmap.md
BACKEND_API_DOC=.docs/plan/backend-api.md

# --- Unity Code Layout & Assemblies ---
SCRIPTS_ROOT=Assets/Scripts
CORE_DIR=Assets/Scripts/Core
VIEW_DIR=Assets/Scripts/View
EDITOR_DIR=Assets/Editor
TESTS_DIR=Assets/Tests/Core

CORE_ASM=Unruled.Core
VIEW_ASM=Unruled.View
EDITOR_ASM=Unruled.Editor
TESTS_ASM=Unruled.Tests.Core

# --- External Tools & Reference ---
ADB_PATH=D:\LDPlayer\LDPlayer14\adb.exe
REF_GAME_PACKAGE=com.gof.global
UNITY_MCP_SKILL_VERSION=1.0.1

# --- Agent-Specific Settings ---
CLAUDE_MODEL_PRIMARY=Opus
CLAUDE_MODEL_SECONDARY=Sonnet

CLAUDE_RULES_DIR=.claude/rules
CLAUDE_SKILLS_DIR=.claude/skills
CLAUDE_MCP_CONFIG=.mcp.json

AGENTS_RULES_DIR=.agents/rules
AGENTS_SKILLS_DIR=.agents/skills
AGENTS_MCP_CONFIG=.mcp.json

CODEX_RULES_DIR=.codex/rules
CODEX_SKILLS_DIR=.codex/skills
CODEX_MCP_CONFIG=.codex/config.toml

CURSOR_RULES_DIR=.cursor/rules
CURSOR_MCP_CONFIG=.cursor/mcp.json
